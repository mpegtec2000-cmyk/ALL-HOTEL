# ====================================================================
# ALL RENT HOTELES QUINTERO - Variables de Entorno de Producción (Go-Live)
# Copiar a .env.local (local) o configurar en Vercel Project Settings
# ====================================================================

# 1. Dominio Oficial del Sitio Web (SEO & Correos)
NEXT_PUBLIC_SITE_URL=https://allrenthoteles.cl

# 2. Seguridad Administrativa (Cambiar en Producción)
ADMIN_PIN=
RECEPTION_PIN=
QR_ENGINE_SECRET=

# 3. Pasarela de Pagos Oficial Flow.cl (Webpay, Redcompra, Tarjetas, Mach)
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_API_URL=https://www.flow.cl/api

# 4. Correos Oficiales & Sincronización Dual Airbnb (2 Cuentas con Contraseña de Aplicación)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

AIRBNB_WEBHOOK_SECRET=
AIRBNB_ACCOUNT_1_EMAIL=
AIRBNB_ACCOUNT_1_APP_PASSWORD=
AIRBNB_ACCOUNT_2_EMAIL=
AIRBNB_ACCOUNT_2_APP_PASSWORD=

# 5. Base de Datos Cloud PostgreSQL (Supabase - ver supabase/schema.sql)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 6. Copiloto IA (Opcional - cuenta con motor local de 10 Agent Skills integrado)
GEMINI_API_KEY=
